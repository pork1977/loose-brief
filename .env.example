# Copy to .env.local (never committed) and fill in.

# Live mode. Without a key the Ebbfield demo still works end to end, and the
# app says live generation isn't switched on. Use a key made only for Loose
# Brief, with a monthly spend limit set in the Anthropic console: that limit is
# the one hard ceiling on cost.
ANTHROPIC_API_KEY=

# Optional. The model for live mode. Defaults to claude-sonnet-5.
# LIVE_MODEL=claude-sonnet-5

# Optional. Limits per visitor (per hour) and per day. These are counted in
# memory on each server instance, so they slow people down rather than
# guarantee a total.
# LIVE_DIRECTIONS_PER_HOUR=3
# LIVE_DIRECTIONS_PER_DAY=30
# LIVE_REFINE_PER_HOUR=20
# LIVE_REFINE_PER_DAY=300
